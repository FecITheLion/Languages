# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PRETTY_BASE_PATH: URL base prefix for pretty node/member/template slugs (/ or /studio/).
PRETTY_BASE_PATH="/"

# GRAMMAR2JSON_STATE_DIR: Absolute private directory (0700) strictly outside the public webroot for PHP SQLite persistence.
# GRAMMAR2JSON_STATE_DIR="/var/lib/grammar2json-state"

# Security hardening (both Node Express and native PHP):
# Comma-separated CORS origin allowlist (leave unset in local dev to allow '*').
# ALLOWED_ORIGINS="https://studio.example.com,https://app.example.com"
# Optional Bearer / X-API-Key token required for mutating API routes (POST/PUT/PATCH/DELETE).
# GRAMMAR2JSON_WRITE_TOKEN=""
# Write requests per minute allowed per client IP (default 120 in Node; 0 disables).
# GRAMMAR2JSON_RATE_LIMIT_MAX="120"

# Optional Cloud Integrations (DEFAULT DISABLED)
ENABLE_AZURE_SUPPORT="false"
# AZURE_FOUNDRY_PROJECT_ENDPOINT="https://<resource>.services.ai.azure.com/api/projects/<project>"
# AZURE_FOUNDRY_PROPRIETARY_MODEL="gpt-4.1"
# AZURE_FOUNDRY_OPEN_MODEL="Llama-3.3-70B-Instruct"

ENABLE_AWS_SUPPORT="false"
# AWS_REGION="us-east-1"
# AWS_BEDROCK_PROPRIETARY_MODEL="anthropic.claude-3-7-sonnet-20250219-v1:0"
# AWS_BEDROCK_OPEN_MODEL="meta.llama3-3-70b-instruct-v1:0"
